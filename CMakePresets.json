{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {}
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "TestDebug",
            "inherits": "Debug",
            "cacheVariables": {
                "RTOS_SELF_TEST": "ON"
            }
        },
        {
            "name": "TestRelease",
            "inherits": "Release",
            "cacheVariables": {
                "RTOS_SELF_TEST": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "TestDebug",
            "configurePreset": "TestDebug"
        },
        {
            "name": "TestRelease",
            "configurePreset": "TestRelease"
        }
    ]
}
